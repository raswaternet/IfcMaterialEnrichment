# Material data (might end up partly contained in a different dictionary)
midas-materials:CONCRETE 
    a ifc:IfcMaterial ;
    rdfs:label "CONCRETE" ;
    rdfs:comment "Hard, compact, unprocessed, fibrous cellulose substance. The roots, trunks and branches of trees and shrubs consist of this tissue." ;
    rdfs:subClassOf midas-materials:SAND ;
    ifc-presentation:diffuseColor [
        ifc-presentation:Red 0.5 ;
        ifc-presentation:Green 0.5 ;
        ifc-presentation:Blue 0.5 ;
    ] ;
    ifc-presentation:opacity 1 .

midas-materials:WOOD 
    a ifc:IfcMaterial ;
    rdfs:label "WOOD" ;
    rdfs:comment "Hard, compact, unprocessed, fibrous cellulose substance. The roots, trunks and branches of trees and shrubs consist of this tissue." ;
    rdfs:subClassOf midas-materials:TIMBER ;
    ifc-presentation:diffuseColor [
        ifc-presentation:Red 0.8 ;
        ifc-presentation:Green 0.7 ;
        ifc-presentation:Blue 0.6 ;
    ] ;
    ifc-mat:StrengthClass "C24" ;
    ifc-mat:MoistureContent 0.56 ;
    ifc-mat:MassDensity 529.0 ;
    ifc-prop:GWP [
        ifc-mat:A1-A3 -629.4 ;
        ifc-mat:A4 0 ;
        ifc-mat:A5 0 ;
        ifc-mat:C2 1.802 ;
        ifc-mat:C3 863 ;
        ifc-mat:D -274.8 ;
    ] .
    
midas-materials:GLASS 
    a ifc:IfcMaterial ;
    rdfs:label "GLASS" ;
    rdfs:comment "Transparent, hard substance made by fusing soda-silica which solidifies from a molten state." ;
    rdfs:subClassOf midas-materials:MAN_MADE_MATERIAL ;
    ifc-presentation:diffuseColor [
        ifc-presentation:Red 0.5 ;
        ifc-presentation:Green 0.8 ;
        ifc-presentation:Blue 0.6 ;
    ] ;
    ifc-presentation:opacity 0.3 .